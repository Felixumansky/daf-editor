{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The editor window. Least privilege: no generic fs/shell access; files go through Daf's own commands.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "allow-app-ready",
    "allow-app-shown",
    "allow-app-quit-ready",
    "allow-file-new",
    "allow-file-open-dialog",
    "allow-file-open-paths",
    "allow-file-open-binary",
    "allow-file-read-text",
    "allow-file-save",
    "allow-file-save-as",
    "allow-file-reopen",
    "allow-file-reload",
    "allow-file-set-format",
    "allow-file-check-disk",
    "allow-file-close",
    "allow-file-reveal",
    "allow-doc-restore",
    "allow-session-put-meta",
    "allow-session-put-buffer",
    "allow-session-get-buffer",
    "allow-session-drop-buffer",
    "allow-session-prune",
    "allow-settings-get",
    "allow-settings-update",
    "allow-settings-open-file",
    "allow-recent-list",
    "allow-recent-clear"
  ]
}
